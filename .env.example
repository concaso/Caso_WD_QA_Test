# Base URL of the application under test
BASE_URL=https://suite.walkerdunlop.com

# Authenticated user credentials
# Obtain a test account from your team — do NOT commit real credentials
TEST_USER_EMAIL=your-test-user@example.com
TEST_USER_PASSWORD=your-test-password

# Optional: a known property address to use in search tests
# Using a stable, well-known address reduces flakiness
TEST_SEARCH_ADDRESS=227 W Monroe St, Chicago, IL
TEST_SEARCH_PROPERTY_NAME=Monroe Plaza

# Set to true to enable global auth setup (login once, reuse session across all tests)
# Requires TEST_USER_EMAIL and TEST_USER_PASSWORD to be set
ENABLE_GLOBAL_SETUP=false
